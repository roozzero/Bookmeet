# ==========================================
# MySQL Database Configuration (XAMPP / cPanel)
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bookmeet_db

# ==========================================
# Application Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Initial Administrator Account Configuration
# (Used once by `npm run init-admin` or on first startup if no admin exists)
# ==========================================
ADMIN_NAME=سهراب رستگار
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bookmeet.ir
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
